# ==========================================================================
# ARVISX AI — variáveis do serviço.
# No EasyPanel elas vão na aba "Environment"; este arquivo é só o modelo.
# Copie para .env quando for rodar na sua máquina.
# ==========================================================================

# ------------------------------- servidor ---------------------------------
PORT=3000
HOST=0.0.0.0

# Prefixo em que o site é publicado.
# VAZIO quando o site é a raiz de um domínio ou subdomínio (arvisx.ai) — é o
# caso hoje. Com um valor aqui (ex.: /arvisx), o servidor responde na raiz E
# no prefixo, para o caso de o site ficar numa subpasta.
BASE_PATH=

# Endereço público completo — vai nas tags canonical, og:, RSS e sitemap.
# Precisa bater com o endereço real, senão o Google indexa o errado.
SITE_URL=https://arvisx.ai

# --------------------------------- pastas ---------------------------------
# Onde ficam posts.json e o HTML gerado.
# ESTA PASTA PRECISA SER UM VOLUME no EasyPanel, senão os posts novos
# desaparecem a cada redeploy.
DATA_DIR=/app/data

# ---------------------------------- admin ---------------------------------
# Sem ADMIN_PASSWORD o painel fica bloqueado. Use uma senha longa.
ADMIN_USER=arvisx
ADMIN_PASSWORD=troque-esta-senha

# --------------------------------- OpenAI ---------------------------------
OPENAI_API_KEY=sk-...
# Troque pelo modelo que a sua conta tiver disponível.
OPENAI_MODEL=gpt-4o

# -------------------------------- geração ---------------------------------
# Um post por semana, terça às 9h de Brasília.
# Formato: minuto hora dia mês dia-da-semana (0=domingo, 2=terça).
CRON_AGENDA=0 9 * * 2
CRON_ATIVO=true
TZ_AGENDA=America/Sao_Paulo

# false = o post nasce como rascunho e espera aprovação no /admin (recomendado)
# true  = publica sozinho, sem ninguém olhar
AUTO_PUBLICAR=false

# ------------------------------- contato ----------------------------------
# Com WHATSAPP preenchido (só dígitos, com DDI), as chamadas do blog abrem a
# conversa já com o contexto do artigo. Vazio, elas caem no Instagram.
WHATSAPP=
INSTAGRAM=https://instagram.com/arvisxai
TIKTOK=https://tiktok.com/@arvisxai
